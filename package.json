{
  "name": "linux-drive",
  "productName": "LinuxDrive",
  "version": "0.1.0",
  "description": "An unofficial Proton Drive client for Linux (Debian-based)",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "concurrently --kill-others \"npm run watch:main\" \"npm run watch:renderer\" \"npm run electron:dev\"",
    "watch:main": "webpack --config webpack.main.config.js --watch --mode development",
    "watch:renderer": "webpack --config webpack.renderer.config.js --watch --mode development",
    "electron:dev": "wait-on dist/main/index.js dist/renderer/index.html && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "dist": "npm run build && electron-builder --linux",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@protontech/drive-sdk": "file:../sdk/js/sdk",
    "bcryptjs": "^2.4.3",
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "fuse-native": "^2.5.0",
    "keytar": "^7.9.0",
    "openpgp": "^5.11.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.0",
    "css-loader": "^7.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.5.0",
    "wait-on": "^8.0.0",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
